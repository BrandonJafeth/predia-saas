---
// Generada en el build desde la API pública (key de portal, solo servidor).
// La ruta lleva la inmobiliaria porque el slug de una propiedad es único
// dentro de su inmobiliaria, no en todo el portal.
import Layout from '../../../layouts/Layout.astro';
import CTABanner from '../../../components/CTABanner.astro';
import LeadForm from '../../../components/LeadForm.astro';
import {
  formatAttributes,
  formatLocation,
  formatPrice,
  getAllPropertyDetails,
} from '../../../lib/properties';
import type { PropertyDetail } from '../../../lib/types/property';
import { whatsappLink } from '../../../lib/site-config';
import { amenityIcons, DEFAULT_AMENITY_ICON } from '../../../lib/amenity-icons';
import { attributeIcons, DEFAULT_ATTRIBUTE_ICON } from '../../../lib/attribute-icons';

export async function getStaticPaths() {
  const properties = await getAllPropertyDetails();
  return properties.map((property) => ({
    params: { agencia: property.agency.slug, slug: property.slug },
    props: { property },
  }));
}

interface Props {
  property: PropertyDetail;
}

const { property } = Astro.props;
const attributes = formatAttributes(property);
const images = property.images;
const total = images.length;
const operationLabel = { sale: 'Venta', rent: 'Alquiler', lease: 'Arrendamiento' }[property.operation_type];
const agentName = property.agent ? `${property.agent.first_name} ${property.agent.last_name}` : null;
const locationLabel = formatLocation(property);
const contactMessage = `Hola, vi "${property.title}" en Predia y quiero más información.`;
const siteWhatsapp = whatsappLink(contactMessage);
const photoAlt = (i: number) => `${property.title}: foto ${i + 1} de ${total}`;
---

<Layout title={property.title} description={property.description ?? undefined}>
	<nav aria-label="Ruta de navegación" class="mx-auto max-w-6xl px-6 pt-8 md:px-10">
		<ol class="flex flex-wrap items-center gap-1.5 text-[0.8rem] text-muted-dark">
			<li><a href="/propiedades" class="underline-offset-4 hover:text-ink hover:underline">Propiedades</a></li>
			<li aria-hidden="true">/</li>
			<li><span>{property.agency.name}</span></li>
			<li aria-hidden="true">/</li>
			<li><a href={Astro.url.pathname} aria-current="page" class="text-ink">{property.title}</a></li>
		</ol>
	</nav>

	<!-- GALERÍA -->
	<section aria-label="Fotos de la propiedad" class="mx-auto mt-5 max-w-6xl px-6 md:px-10">
		<div id="gallery" class="relative aspect-4/3 overflow-hidden rounded-xl bg-ink sm:aspect-16/10 md:aspect-21/9" data-count={total}>
			{total === 0 ? (
				<p class="flex h-full items-center justify-center text-sm text-bg/80">Sin fotos publicadas</p>
			) : (
				<div class="carousel-track" id="gallery-track">
					{images.map((img, i) => (
						<div class="carousel-frame" aria-hidden={i === 0 ? undefined : 'true'} data-frame={i}>
							<button type="button" class="block h-full w-full cursor-zoom-in" data-open-lightbox tabindex={i === 0 ? undefined : '-1'} aria-label={`Ampliar foto ${i + 1} de ${total}`}>
								<img src={img.url} alt={photoAlt(i)} class="h-full w-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
							</button>
						</div>
					))}
				</div>
			)}

			{total > 1 && (
				<>
					<button type="button" class="carousel-btn left-4" data-dir="-1" aria-label="Foto anterior" aria-controls="gallery-track">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
					</button>
					<button type="button" class="carousel-btn right-4" data-dir="1" aria-label="Foto siguiente" aria-controls="gallery-track">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
					</button>

					<p class="carousel-counter absolute bottom-4 right-4 rounded-full bg-ink/70 px-3 py-1 text-[0.72rem] text-bg" aria-live="polite">
						Foto <span id="gallery-current">1</span> de {total}
					</p>
				</>
			)}
			<span class="absolute left-4 top-4 rounded-full bg-bg/95 px-3.5 py-1.5 text-[0.72rem] font-semibold uppercase tracking-wide text-ink">
				{operationLabel}
			</span>
		</div>

		{total > 1 && (
			<ul class="carousel-thumbs mt-3 flex gap-2.5 overflow-x-auto pb-1" aria-label="Miniaturas">
				{images.map((img, i) => (
					<li class="shrink-0">
						<button type="button" class="thumb-btn h-16 w-20 overflow-hidden rounded-lg" data-thumb={i} aria-current={i === 0 ? 'true' : 'false'} aria-label={`Ver foto ${i + 1} de ${total}`}>
							<img src={img.thumbnail_url} alt="" class="h-full w-full object-cover" loading="lazy" decoding="async" />
						</button>
					</li>
				))}
			</ul>
		)}
	</section>

	<!-- TÍTULO + PRECIO -->
	<section class="mx-auto mt-10 max-w-6xl px-6 md:px-10">
		<div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
			<div>
				<h1 class="max-w-xl text-3xl font-semibold leading-tight tracking-[-0.02em] text-ink md:text-4xl">{property.title}</h1>
				{locationLabel && <p class="mt-2 text-sm text-muted-dark">{locationLabel}, Costa Rica</p>}
				<p class="mt-1 text-sm text-muted-dark">Publicada por <strong class="font-medium text-ink">{property.agency.name}</strong></p>
			</div>
			<div class="shrink-0 md:text-right">
				<p class="eyebrow">{operationLabel}</p>
				<p class="mt-1 text-3xl font-semibold tracking-[-0.02em] text-ink md:text-4xl">{formatPrice(property)}</p>
			</div>
		</div>
	</section>

	<div class="mx-auto grid max-w-6xl gap-16 px-6 py-12 md:grid-cols-[1.6fr_1fr] md:px-10">
		<div>
			{attributes.length > 0 && (
				<section aria-labelledby="detalles">
					<h2 id="detalles" class="eyebrow">Detalles</h2>
					<dl class="mt-5 grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2">
						{attributes.map((a) => (
							<div class="flex items-center gap-3 border-b border-border/70 py-2.5">
								<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
									<path d={attributeIcons[a.key] ?? DEFAULT_ATTRIBUTE_ICON} />
								</svg>
								<dt class="text-sm text-muted-dark">{a.label}</dt>
								<dd class="ml-auto text-sm font-medium text-ink">{a.value}</dd>
							</div>
						))}
					</dl>
				</section>
			)}

			{property.description && (
				<section aria-labelledby="descripcion" class="mt-12">
					<h2 id="descripcion" class="eyebrow">Descripción</h2>
					<p class="mt-4 whitespace-pre-line text-[1.02rem] leading-relaxed text-muted-dark">{property.description}</p>
				</section>
			)}

			{property.amenities.length > 0 && (
				<section aria-labelledby="amenidades" class="mt-12">
					<h2 id="amenidades" class="eyebrow">Amenidades</h2>
					<ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3">
						{property.amenities.map((a) => (
							<li class="flex items-center gap-3">
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1C2028" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
									<path d={amenityIcons[a.slug] ?? DEFAULT_AMENITY_ICON} />
								</svg>
								<span class="text-sm text-ink">{a.name}</span>
							</li>
						))}
					</ul>
				</section>
			)}
		</div>

		<aside aria-labelledby="contacto-propiedad-title" class="h-fit rounded-xl border border-border bg-surface p-7 shadow-soft md:sticky md:top-24">
			<p class="eyebrow">{agentName ? 'Agente responsable' : 'Inmobiliaria'}</p>
			<p class="mt-3 text-xl font-semibold tracking-[-0.01em] text-ink">{agentName ?? property.agency.name}</p>
			{agentName && <p class="mt-1 text-sm text-muted-dark">{property.agency.name}</p>}

			<div class="mt-6 border-t border-border pt-6">
				<LeadForm
					id="contacto-propiedad"
					title="Consultar por esta propiedad"
					description="Tu consulta le llega directo a la inmobiliaria que la publica."
					propertySlug={property.slug}
					tenantSlug={property.agency.slug}
					defaultMessage={contactMessage}
				/>
			</div>

			{siteWhatsapp && (
				<a href={siteWhatsapp} target="_blank" rel="noopener noreferrer" class="mt-4 flex items-center justify-center rounded-lg border border-border px-6 py-3 text-sm font-medium text-ink hover:border-ink">
					Escribir por WhatsApp<span class="sr-only"> (se abre en otra pestaña)</span>
				</a>
			)}
		</aside>
	</div>

	<CTABanner
		eyebrow="¿Sos agencia?"
		heading="Publicá tu inventario en Predia"
		subtext="Sumate al portal compartido y llegá a más compradores."
		ctaLabel="Conocer planes"
		ctaHref="/para-agencias"
	/>

	<!-- LIGHTBOX: <dialog> nativo (foco atrapado, Esc y fondo inerte los da el navegador). -->
	{total > 0 && (
		<dialog id="lightbox" aria-labelledby="lightbox-title" class="lightbox">
			<h2 id="lightbox-title" class="sr-only">Fotos de {property.title}</h2>
			<button type="button" id="lightbox-close" class="absolute right-5 top-5 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-bg/10 text-bg hover:bg-bg/20" aria-label="Cerrar galería">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
			</button>
			<div class="relative flex h-full items-center justify-center px-4 md:px-20">
				<div class="h-[78vh] w-full overflow-hidden">
					<div class="carousel-track" id="lightbox-track">
						{images.map((img, i) => (
							<div class="carousel-frame flex items-center justify-center" aria-hidden={i === 0 ? undefined : 'true'} data-frame={i}>
								<img src={img.url} alt={photoAlt(i)} class="max-h-full max-w-full rounded-lg object-contain" loading="lazy" decoding="async" />
							</div>
						))}
					</div>
				</div>
				{total > 1 && (
					<>
						<button type="button" class="carousel-btn left-2 md:left-6" data-dir="-1" aria-label="Foto anterior" aria-controls="lightbox-track">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
						</button>
						<button type="button" class="carousel-btn right-2 md:right-6" data-dir="1" aria-label="Foto siguiente" aria-controls="lightbox-track">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
						</button>
					</>
				)}
				<p class="absolute bottom-6 left-1/2 -translate-x-1/2 rounded-full bg-bg/10 px-3 py-1 text-[0.72rem] text-bg" aria-live="polite">
					Foto <span id="lightbox-current">1</span> de {total}
				</p>
			</div>
		</dialog>
	)}

	<script>
		const count = Number(document.getElementById('gallery')?.dataset.count ?? '0');
		let index = 0;

		const tracks = ['gallery-track', 'lightbox-track']
			.map((id) => document.getElementById(id))
			.filter((el): el is HTMLElement => el !== null);
		const counters = ['gallery-current', 'lightbox-current']
			.map((id) => document.getElementById(id))
			.filter((el): el is HTMLElement => el !== null);
		const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
		const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;

		function render() {
			for (const track of tracks) {
				track.style.transform = `translateX(-${index * 100}%)`;
				// Solo la foto visible queda expuesta a lectores de pantalla y al teclado.
				track.querySelectorAll<HTMLElement>('[data-frame]').forEach((frame) => {
					const current = Number(frame.dataset.frame) === index;
					if (current) frame.removeAttribute('aria-hidden');
					else frame.setAttribute('aria-hidden', 'true');
					frame.querySelectorAll<HTMLElement>('button').forEach((btn) => {
						if (current) btn.removeAttribute('tabindex');
						else btn.setAttribute('tabindex', '-1');
					});
				});
			}
			for (const counter of counters) counter.textContent = String(index + 1);
			thumbs.forEach((t, i) => t.setAttribute('aria-current', i === index ? 'true' : 'false'));
		}

		function go(delta: number) {
			if (count === 0) return;
			index = (index + delta + count) % count;
			render();
		}

		document.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((btn) => {
			btn.addEventListener('click', () => go(Number(btn.dataset.dir)));
		});
		thumbs.forEach((btn) => {
			btn.addEventListener('click', () => {
				index = Number(btn.dataset.thumb);
				render();
			});
		});

		document.querySelectorAll('[data-open-lightbox]').forEach((btn) =>
			btn.addEventListener('click', () => lightbox?.showModal()),
		);
		document.getElementById('lightbox-close')?.addEventListener('click', () => lightbox?.close());
		// Clic en el fondo (fuera de la foto) cierra; Esc lo maneja el propio <dialog>.
		lightbox?.addEventListener('click', (e) => {
			if (e.target === lightbox) lightbox.close();
		});
		// Flechas solo dentro de la galería ampliada: fuera de ella sirven para hacer scroll.
		lightbox?.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') go(-1);
			if (e.key === 'ArrowRight') go(1);
		});

		// Swipe en la galería principal.
		const galleryEl = document.getElementById('gallery');
		let touchStartX = 0;
		galleryEl?.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
		galleryEl?.addEventListener('touchend', (e) => {
			const delta = e.changedTouches[0].clientX - touchStartX;
			if (Math.abs(delta) > 40) go(delta < 0 ? 1 : -1);
		}, { passive: true });
	</script>
</Layout>
