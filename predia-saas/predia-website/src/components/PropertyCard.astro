---
import type { PropertySummary } from '../lib/types/property';
import { formatPrice, propertyPath } from '../lib/properties';

interface Props {
  property: PropertySummary;
  /** Nivel del título según la página que la contiene (h2 en listados, h3 bajo una sección). */
  headingLevel?: 'h2' | 'h3';
}
const { property, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

const operationLabel: Record<PropertySummary['operation_type'], string> = {
  sale: 'Venta',
  rent: 'Alquiler',
  lease: 'Arrendamiento',
};

const locationLabel = property.location?.name ?? null;
const cover = property.cover_image;
---

<a href={propertyPath(property)} class="group block rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink">
	<div class="relative aspect-4/3 overflow-hidden rounded-xl bg-secondary">
		{cover ? (
			<img
				src={cover.thumbnail_url}
				alt=""
				width="640"
				height="480"
				class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none"
				loading="lazy"
				decoding="async"
			/>
		) : (
			<div class="absolute inset-0 flex items-center justify-center">
				<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="1.5" /><path d="m4 17 5-4 4 3 3-2.5L21 17" />
				</svg>
			</div>
		)}

		<span class="absolute left-3 top-3 rounded-md bg-bg/95 px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-wide text-ink shadow-soft">
			{operationLabel[property.operation_type]}
		</span>
	</div>

	<div class="mt-3.5">
		<p class="eyebrow">{property.category.name}{locationLabel ? ` · ${locationLabel}` : ''}</p>
		<Heading class="mt-1.5 text-[1.05rem] font-semibold tracking-[-0.01em] leading-snug text-ink transition-colors group-hover:text-muted-dark">
			{property.title}
		</Heading>
		<p class="mt-1.5 text-[0.95rem] font-medium text-ink">{formatPrice(property)}</p>
		<p class="mt-1 text-[0.8rem] text-muted">{property.agency.name}</p>
	</div>
</a>
